  <property name="styleSheet">
   <string notr="true">*{
color: rgb(255, 255, 255);
background: rgb(48, 49, 51);
border:  0px;
}
#combatButton, #safeFlyButton, #landButton,
#kamikazeButton, #homePositionButton,
#escapeButton, #takeOffButton {border-radius: 10px; height:70px}
#frame_2, #frame_3 {border-radius: 10px;}

#label_3, #label_15, #label_11, #label_5, #label_17, #label_13, #label_23, #label_21, #label_19, #speed, #battery, #roll, #height, #latitude, #pitch, #flightTime, #longitude, #yaw{
	background: rgb(55, 59, 60);
	margin-left:5px;
	margin-right:5px;}

#label_3, #label_15, #label_11, #label_5, #label_17, #label_13, #label_23, #label_21, #label_19 {
	border-top-left-radius: 15px;
    border-top-right-radius: 15px;
	margin-top:10px;}

#speed, #battery, #roll, #height, #latitude, #pitch, #flightTime, #longitude, #yaw{
	border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
	margin-bottom: 10px}

QTabBar::tab:first {margin-left:10px}

QTabBar::tab {
    background: red;
    color: white;
    padding: 5px;
    border: 1px solid black;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}</string>
